{
  "name": "angular20-saucelabs-a11y-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Angular 20 Hello World app with Sauce Labs WebdriverIO + axe accessibility testing and Devin/Sauce MCP examples.",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "test:a11y": "wdio run tests/wdio.conf.js",
    "test:a11y:chrome": "cross-env A11Y_TARGET=chrome wdio run tests/wdio.conf.js",
    "test:a11y:safari": "cross-env A11Y_TARGET=safari wdio run tests/wdio.conf.js",
    "test:a11y:iphone": "cross-env A11Y_TARGET=iphone wdio run tests/wdio.conf.js",
    "test:a11y:android": "cross-env A11Y_TARGET=android wdio run tests/wdio.conf.js"
  },
  "dependencies": {
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@angular/router": "20.3.32",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.32",
    "@axe-core/webdriverio": "4.13.0",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/sauce-service": "9.30.1",
    "@wdio/spec-reporter": "^9.32.0",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
